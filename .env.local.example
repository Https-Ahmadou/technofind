# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TechnoFind

# ── Auth (JWT) ────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Base de données ───────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/technofind
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/technofind

# ── APIs Actualités ───────────────────────────────────────────
NEWSAPI_KEY=your_newsapi_key_here
GUARDIAN_API_KEY=your_guardian_api_key_here

# ── Firebase Auth ─────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=

# ── OpenAI (résumés IA) ───────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here

# ── Google Cloud ──────────────────────────────────────────────
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TTS_API_KEY=

# ── Web Push (VAPID) ──────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Redis (Upstash — free tier) ───────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
